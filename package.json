{
  "name": "home-manager",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "check": "tsc --noEmit",
    "check:public": "node scripts/check-public.mjs",
    "format": "prettier --write web server shared scripts test",
    "start": "node dist/server/index.js",
    "test": "tsx --test test/*.test.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.8",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@mantine/core": "9.7.4",
    "@mantine/dates": "9.7.4",
    "@mantine/form": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@tabler/icons-react": "^3.35.0",
    "archiver": "^7.0.1",
    "dayjs": "^1.11.13",
    "fastify": "5.12.7",
    "pdfkit": "^0.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yauzl": "3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
